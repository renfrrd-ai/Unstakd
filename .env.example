# Platform database and queue (dev values match docker-compose.dev.yml)
DATABASE_URL=postgres://unstakd:unstakd@127.0.0.1:5434/unstakd
REDIS_URL=redis://127.0.0.1:6380

# 32-byte master key for env vars and DB credentials, hex encoded.
# Generate with: pnpm key:generate  (writes .data/master.key)
UNSTAKD_KEY_FILE=.data/master.key

# Public URL of the dashboard and the apex for app subdomains
APP_URL=http://localhost:3000
APPS_DOMAIN=localhost
# Custom domains CNAME to EDGE_HOST; apex domains use an A record to EDGE_IP
EDGE_HOST=edge.unstakd.com
EDGE_IP=

# Sign-in: GitHub OAuth app + allowlisted logins (comma separated)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_LOGINS=
# 32+ random chars, seals the session cookie
SESSION_SECRET=

# Where build logs are written (one file per deployment)
LOG_DIR=.data/logs

# Docker access for the API and worker
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=unstakd
# Set to false only if this host rejects no-new-privileges (every container exits 255)
DOCKER_NO_NEW_PRIVILEGES=true

# Database backups: Cloudflare R2 when all four are set, otherwise BACKUP_DIR on local disk
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_DIR=.data/backups
BACKUP_CRON=0 3 * * *
TZ=America/Toronto
