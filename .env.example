# Platform database and queue (dev values match docker-compose.dev.yml)
DATABASE_URL=postgres://unstakd:unstakd@127.0.0.1:5434/unstakd
REDIS_URL=redis://127.0.0.1:6380

# 32-byte master key for env vars and DB credentials, hex encoded.
# Generate with: pnpm key:generate  (writes .data/master.key)
UNSTAKD_KEY_FILE=.data/master.key

# Public URL of the dashboard and the apex for app subdomains
APP_URL=http://localhost:3000
APPS_DOMAIN=localhost

# Sign-in: GitHub OAuth app + allowlisted logins (comma separated)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_LOGINS=
# 32+ random chars, seals the session cookie
SESSION_SECRET=
