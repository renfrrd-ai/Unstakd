{
  "name": "unstakd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "dev:services": "docker network inspect unstakd >/dev/null 2>&1 || docker network create unstakd >/dev/null; docker compose -f docker-compose.dev.yml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "key:generate": "tsx --env-file-if-exists=.env.local scripts/generate-key.ts",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env.local src/worker/index.ts",
    "check": "pnpm typecheck && pnpm lint --max-warnings 0 && pnpm test",
    "cli": "node cli/unstakd.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/lib-storage": "^3.1171.0",
    "bullmq": "^6.7.7",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "iron-session": "^9.1.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "unstakd": "cli/unstakd.mjs"
  }
}
